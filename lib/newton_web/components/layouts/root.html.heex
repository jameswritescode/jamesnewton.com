<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#151311" />
    <%!-- The site has a single dark palette; declare it so native UI is dark and
    there's no white first-paint flash. --%>
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon-32.png"} sizes="32x32" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <meta :if={assigns[:page_robots]} name="robots" content={assigns[:page_robots]} />
    <SEO.juice conn={@conn} config={NewtonWeb.SEO.config()} page_title={assigns[:page_title]} />
    <link
      :if={publication_uri = Newton.Standard.publication_uri()}
      rel="site.standard.publication"
      href={publication_uri}
    />
    <link
      :if={assigns[:standard_document]}
      rel="site.standard.document"
      href={@standard_document}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400;1,600&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Anti-FOUC for the /links Gibson (authorized exception to the no-inline-
    script rule; safe here — the root <head> is outside LiveView-managed DOM).
    The Gibson takes over /links for every visitor except ?fallback/no-WebGL,
    but that decision lives in deferred app.js, which can run AFTER first
    paint — flashing the fallback page. This blocking script blacks out the
    page (header, background, content — see html.gibson-takeover in site.css)
    before paint. gibson_intro takes charge of the class from there: it keeps
    the blackout up for the Gibson's whole session (it is what shows through
    whenever a buffer resize leaves the canvas momentarily transparent) and
    removes it only when the DOM page should return (no WebGL, bail, skip).
    The timeout is a failsafe — if app.js never runs, the page comes back
    rather than staying blank — and gibson_intro cancels it via the exposed
    timer id when it takes over. No-JS visitors never run this, so the
    fallback page shows normally. --%>
    <script nonce={assigns[:csp_nonce]} phx-no-curly-interpolation>
      (function () {
        if (window.location.pathname !== "/links") return
        if (new URLSearchParams(window.location.search).has("fallback")) return
        var root = document.documentElement
        root.classList.add("gibson-takeover")
        window.__gibsonHoldFailsafe = setTimeout(function () {
          root.classList.remove("gibson-takeover")
        }, 4000)
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="ripple-canvas" id="rippleCanvas" phx-hook="RippleCanvas" aria-hidden="true">
    </canvas>
    <div id="route-announcer" class="sr-only" role="status" aria-live="polite"></div>
    {@inner_content}
  </body>
</html>
