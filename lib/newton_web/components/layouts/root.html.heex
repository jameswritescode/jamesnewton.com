<!DOCTYPE html>
<%!-- Public site is dark-only: the dark theme is forced with the html class so
there's no light flash and no system-preference switching. Restore from git
history (drop the class, re-add the matchMedia toggle below) to bring light back. --%>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#151311" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon-32.png"} sizes="32x32" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <.live_title default="James Newton" prefix={title_prefix()}>
      {assigns[:page_title]}
    </.live_title>
    <meta :if={assigns[:page_robots]} name="robots" content={assigns[:page_robots]} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:site_name" content="James Newton" />
    <meta property="og:title" content={assigns[:og_title] || "James Newton"} />
    <meta
      property="og:description"
      content={assigns[:og_description] || "Software & Photography"}
    />
    <meta property="og:url" content={assigns[:og_url] || Phoenix.Controller.current_url(@conn)} />
    <meta property="og:image" content={assigns[:og_image] || url(~p"/og-default.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:og_title] || "James Newton"} />
    <meta
      name="twitter:description"
      content={assigns[:og_description] || "Software & Photography"}
    />
    <meta name="twitter:image" content={assigns[:og_image] || url(~p"/og-default.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400;1,600&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Light/dark switching removed for the dark-only public site (see the html
    tag above). The prefers-color-scheme toggle that set the `dark` class lived
    here; restore it from git history if light mode returns. --%>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="ripple-canvas" id="rippleCanvas" phx-hook="RippleCanvas" aria-hidden="true">
    </canvas>
    <div id="route-announcer" class="sr-only" role="status" aria-live="polite"></div>
    {@inner_content}
  </body>
</html>
