<Layouts.site_header />
<main id="main">
  <article class="post error-page">
    <h1 class="error-code">404</h1>
    <p class="error-message">Couldn't find the page you were looking for.</p>
    <p><.link href={~p"/"} class="error-home">← Back home</.link></p>
  </article>
  <%!-- Inside #main so Swup adds/removes it with the page; the RippleCanvas
        hook watches for it to draw a frown into the dot matrix. --%>
  <div data-frown hidden></div>
</main>
