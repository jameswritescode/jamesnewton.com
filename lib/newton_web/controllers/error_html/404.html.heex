<Layouts.site_header />
<main id="main">
  <article class="post error-page">
    <h1 class="error-code">404</h1>
    <p class="error-message">This page wandered off.</p>
    <p><.link href={~p"/"} class="error-home">← Back home</.link></p>
  </article>
</main>
<%!-- Tells the RippleCanvas hook to draw a frown into the dot matrix. --%>
<div data-frown hidden></div>
