<%!-- The site-styled fallback page. The Gibson cinematic does NOT read this
markup — it reads the #gibson-links JSON island below, so the visible page and
the tower menu are free to present the same links differently. Most visitors
never see this page; it serves no-JS/no-WebGL browsers, crawlers, and
?fallback. --%>
<Layouts.app flash={@flash}>
  <article class="post" aria-label="Links">
    <header>
      <h1 class="post-title">Links</h1>
      <p class="post-byline">Where to find me elsewhere.</p>
    </header>

    <.feed>
      <.feed_item
        :for={link <- @links}
        href={link.url}
        {if external?(link.url), do: [target: "_blank", rel: "noopener noreferrer"], else: []}
      >
        <span class="links-name">{link.name}</span>
        <p :if={link.description} class="feed-item-excerpt">{link.description}</p>
      </.feed_item>
    </.feed>
  </article>

  <%!-- Data island, not executable script: the Gibson's link manifest. --%>
  <script type="application/json" id="gibson-links">
    <%= raw(gibson_manifest(@links)) %>
  </script>
</Layouts.app>
