<Layouts.app flash={@flash}>
  <article class="post">
    <header>
      <h1 class="post-title">{@post.title}</h1>
      <p class="post-byline">
        {format_date(@post.published_at)} · {@post.reading_time} min read
      </p>
    </header>

    <section class="post-body">
      {Phoenix.HTML.raw(@post.body_html)}
    </section>
  </article>
</Layouts.app>
