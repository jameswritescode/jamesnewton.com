<Layouts.app flash={@flash}>
  <div :if={@preview} class="preview-banner">
    <strong>Draft preview</strong>
    <span>Not published — please keep this link private.</span>
  </div>

  <article class="post">
    <header>
      <h1 class="post-title">{@post.title}</h1>
      <p class="post-byline">
        {format_date(@post.published_at, on_nil: "Unpublished")} · {format_reading_time(
          @post.reading_time
        )}
      </p>
    </header>

    <section class="post-body">
      {Phoenix.HTML.raw(@post.body_html)}
    </section>
  </article>
</Layouts.app>
