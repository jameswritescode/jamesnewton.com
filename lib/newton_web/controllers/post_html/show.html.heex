<Layouts.app flash={@flash}>
  <div :if={@preview == :admin} class="preview-banner">
    <%= if Newton.Blog.publish_status(@post.published_at) == :scheduled do %>
      <strong>Scheduled — not public</strong>
      <span>Only you can see this post until it goes live.</span>
    <% else %>
      <strong>Draft — not public</strong>
      <span>Only you can see this post until it is published.</span>
    <% end %>
  </div>

  <div :if={@preview == :link} class="preview-banner">
    <strong>Draft preview</strong>
    <span>Not published — please keep this link private.</span>
  </div>

  <.content_article title={@post.title} body_html={@post.body_html}>
    <:byline>
      <p class="post-byline">
        {format_date(@post.published_at, on_nil: "Unpublished")} · {format_reading_time(
          @post.reading_time
        )}
      </p>
    </:byline>
  </.content_article>
</Layouts.app>
