<Layouts.app flash={@flash}>
  <article class="post">
    <header>
      <h1 class="post-title">Reading</h1>
    </header>

    <.feed>
      <%= for item <- @entries do %>
        <%= case item do %>
          <% {:series, name, entries} -> %>
            <.series_group name={name} entries={entries} />
          <% %Newton.Reading.Entry{} = entry -> %>
            <.book_item entry={entry} />
        <% end %>
      <% end %>
    </.feed>
  </article>
</Layouts.app>
